# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it.

# Random string used to sign sessions and CSRF tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

SQLALCHEMY_DATABASE_URI=sqlite:///database.db

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

PAYMENT_GATEWAY_MODE=remita

# Remita test/demo sandbox — these six values are Remita's published sandbox
# credentials (remitademo.net / demo.remita.net), not production secrets.
# Safe to keep as-is for local development.
